{
    "name": "Minimal Ubuntu Sandbox",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    
    // Log in as the 'vscode' user (mimicking a local system user)
    "remoteUser": "vscode",
    "containerUser": "vscode",

    "features": {
        // We are avoiding 'features' as requested, so we use the script below
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg"
            ]
        }
    },

    // Grants the vscode user 'NOPASSWD' sudo power and runs the setup
    "postCreateCommand": "echo 'vscode ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/vscode && bash .devcontainer/setup.sh",

    "forwardPorts": [5432]
}